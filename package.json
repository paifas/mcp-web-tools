{
  "name": "mcp-web-tools",
  "version": "0.8.0",
  "description": "MCP server providing web search tools for AI assistants",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "mcp-web-tools": "./build/index.js"
  },
  "files": [
    "build",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "docs/clients.md",
    "docs/configuration.md",
    "docs/self-hosting.md",
    "docs/tools.md",
    "docs/troubleshooting.md"
  ],
  "scripts": {
    "build": "tsc && chmod 755 build/index.js",
    "dev": "tsx src/index.ts",
    "start": "node build/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.mjs\" vitest.config.ts",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.mjs\" vitest.config.ts",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run typecheck && npm test && npm run lint && npm run format:check && npm run build && npm run smoke",
    "check:release": "npm run check && npm audit",
    "prepublishOnly": "npm run check:release"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paifas/mcp-web-tools.git"
  },
  "homepage": "https://github.com/paifas/mcp-web-tools#readme",
  "bugs": {
    "url": "https://github.com/paifas/mcp-web-tools/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "web-search",
    "web-reader",
    "web-scraping",
    "content-extraction",
    "searxng",
    "firecrawl",
    "tavily",
    "self-hosted",
    "ai",
    "claude",
    "claude-code",
    "claude-desktop",
    "opencode"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
